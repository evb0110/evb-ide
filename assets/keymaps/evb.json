// EVB IDE key bindings, loaded after the base keymap so they win over it.
// User keymaps still override these.
[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-r": "evb_run::Run",
      "ctrl-d": "evb_run::Debug",
      "cmd-f2": "evb_run::Stop",
      "ctrl-alt-r": "evb_run::ChooseConfiguration",
      "cmd-j": "workspace::ToggleBottomDock",
    },
  },
  {
    // JetBrains binds these in the editor too, replacing the macOS
    // delete-forward and select-all-occurrences defaults.
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-r": "evb_run::Run",
      "ctrl-d": "evb_run::Debug",
      "cmd-f2": "evb_run::Stop",
      // JetBrains puts Hover on cmd-j; move it to F1 (WebStorm's Quick
      // Documentation) so cmd-j toggles the bottom dock as in Zed.
      "cmd-j": "workspace::ToggleBottomDock",
      "f1": "editor::Hover",
    },
  },
  {
    // Enter adds a line in the commit message; cmd-enter saves it.
    "context": "CommitMessageModal > Editor",
    "bindings": {
      "cmd-enter": "menu::Confirm",
    },
  },
  {
    "context": "GitPanel || CommitEditor > Editor",
    "bindings": {
      "cmd-alt-k": "git_panel::CommitAndPush",
    },
  },
  {
    // The shell owns these keys inside a terminal.
    "context": "Terminal",
    "bindings": {
      "ctrl-r": ["terminal::SendKeystroke", "ctrl-r"],
      "ctrl-d": ["terminal::SendKeystroke", "ctrl-d"],
    },
  },
]
