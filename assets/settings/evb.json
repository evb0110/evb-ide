// EVB IDE defaults.
//
// This layer is merged over `default.json` at startup (see
// `settings::app_default_settings`). Keep EVB-specific defaults here so that
// `default.json` stays identical to upstream Zed and rebases cleanly.
// User settings still override everything in this file.
{
  "base_keymap": "JetBrains",
  "theme": {
    "mode": "system",
    "light": "IntelliJ Light",
    "dark": "IntelliJ Dark",
  },
  // These icons are embedded so fresh installations need no separate extension.
  "icon_theme": {
    "mode": "system",
    "light": "JetBrains Icons Light",
    "dark": "JetBrains Icons Dark",
  },
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 13,
  // WebStorm renders JetBrains Mono without ligatures by default.
  "buffer_font_features": { "calt": false },
  "buffer_line_height": { "custom": 1.4 },
  "ui_font_family": "Inter",
  "ui_font_size": 13,
  "title_bar": {
    "show_onboarding_banner": false,
    "show_sign_in": false,
    "show_user_picture": false,
  },
  // WebStorm keeps Project and Commit as tool windows on the left.
  "project_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
  },
  "git_panel": {
    "dock": "left",
  },
  // WebStorm-style annotations: date and last name, no avatar.
  "git": {
    "blame": { "show_avatar": false },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  // Like WebStorm, every project opens in its own window, and on macOS those windows are tabs of
  // one window. Opening a project that is already open brings its tab to the front. (With the
  // agent off there is no projects sidebar, so "existing_window" would replace the open project.)
  "default_open_behavior": "new_window",
  "cli_default_open_behavior": "new_window",
  "use_system_window_tabs": true,
  // AI features are off by default. These are ordinary settings, so user
  // settings can turn them back on ("disable_ai" cannot be used here: once a
  // lower layer sets it to true, no higher layer can set it back to false).
  "agent": {
    "enabled": false,
    "button": false,
  },
  "edit_predictions": {
    "provider": "none",
  },
  "auto_update": false,
  "show_call_status_icon": false,
  "auto_install_extensions": {
    "html": true,
    "vue": true,
    "php": true,
    "blade": true,
    "stylelint": true,
  },
  "file_types": {
    "Blade": ["*.blade.php"],
  },
  "languages": {
    // Intelephense runs on Node; Phpactor needs PHP 8.2+ on PATH and fails
    // silently with older PHP. Free Intelephense has no rename; switch to
    // phpactor here when a PHP 8.2+ runtime is available.
    "PHP": {
      "language_servers": ["intelephense", "!phpactor", "!phptools", "!phpantom", "..."],
    },
    "Blade": {
      "language_servers": [
        "intelephense",
        "tailwindcss-language-server",
        "!phpactor",
        "!phptools",
        "!phpantom",
        "...",
      ],
      "formatter": "none",
    },
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": { "vue": "html", "blade": "html" },
      },
    },
    "stylelint-lsp": {
      "settings": {
        "stylelint": {
          "validate": ["css", "postcss", "scss", "vue.js"],
        },
      },
    },
  },
}
