// EVB IDE defaults.
//
// This layer is merged over `default.json` at startup (see
// `settings::app_default_settings`). Keep EVB-specific defaults here so that
// `default.json` stays identical to upstream Zed and rebases cleanly.
// User settings still override everything in this file.
{
  "base_keymap": "JetBrains",
  "theme": {
    "mode": "system",
    "light": "IntelliJ Light",
    "dark": "IntelliJ Dark",
  },
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 13,
  // WebStorm renders JetBrains Mono without ligatures by default.
  "buffer_font_features": { "calt": false },
  "buffer_line_height": { "custom": 1.4 },
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 13,
  "title_bar": {
    "show_onboarding_banner": false,
    "show_sign_in": false,
    "show_user_picture": false,
  },
  // WebStorm keeps Project and Commit as tool windows on the left.
  "project_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
  },
  "git_panel": {
    "dock": "left",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  // AI features are off by default; set to false in user settings to bring
  // back the agent panel and edit predictions.
  "disable_ai": true,
  "auto_update": false,
  "show_call_status_icon": false,
  "auto_install_extensions": {
    "html": true,
    "vue": true,
    "php": true,
    "blade": true,
    "stylelint": true,
  },
  "file_types": {
    "Blade": ["*.blade.php"],
  },
  "languages": {
    // Intelephense runs on Node; Phpactor needs PHP 8.2+ on PATH and fails
    // silently with older PHP. Free Intelephense has no rename; switch to
    // phpactor here when a PHP 8.2+ runtime is available.
    "PHP": {
      "language_servers": ["intelephense", "!phpactor", "!phptools", "!phpantom", "..."],
    },
    "Blade": {
      "language_servers": [
        "intelephense",
        "tailwindcss-language-server",
        "!phpactor",
        "!phptools",
        "!phpantom",
        "...",
      ],
      "formatter": "none",
    },
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": { "vue": "html", "blade": "html" },
      },
    },
    "stylelint-lsp": {
      "settings": {
        "stylelint": {
          "validate": ["css", "postcss", "scss", "vue.js"],
        },
      },
    },
  },
}
