#!/usr/bin/env python3
"""Generates assets/themes/intellij/intellij.json, the IntelliJ Light and
IntelliJ Dark themes of EVB IDE.

Colors come from the Apache-2.0 JetBrains/intellij-community sources of the
New UI "Light" (light header) and "Dark" themes and their editor schemes
(IntelliJ 2026.1, branch 261): platform/platform-resources/src/themes/expUI
and the Light/Dark editor color scheme XML files. Where Zed needs a color that
IntelliJ does not define, the value is derived from a neighbouring IntelliJ
color and marked "derived" below.

Usage: script/evb-generate-intellij-themes
"""

import json
from pathlib import Path


def blend(foreground: str, background: str, amount: float) -> str:
    """Mixes `amount` of foreground into background (both #RRGGBB)."""
    fg = [int(foreground[i : i + 2], 16) for i in (1, 3, 5)]
    bg = [int(background[i : i + 2], 16) for i in (1, 3, 5)]
    mixed = [round(b + (f - b) * amount) for f, b in zip(fg, bg)]
    return "#" + "".join(f"{channel:02X}" for channel in mixed)


def terminal(palette: dict, background: str) -> dict:
    colors = {}
    for name, (normal, bright) in palette.items():
        colors[f"terminal.ansi.{name}"] = normal
        colors[f"terminal.ansi.bright_{name}"] = bright
        colors[f"terminal.ansi.dim_{name}"] = blend(normal, background, 0.7)  # derived
    return colors


def style(color, italic=False, bold=False):
    entry = {"color": color, "font_style": "italic" if italic else None, "font_weight": 700 if bold else None}
    return entry


