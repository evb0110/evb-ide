def main() -> None:
    family = {
        "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
        "name": "IntelliJ",
        "author": "EVB IDE, colors from JetBrains/intellij-community (Apache-2.0)",
        "themes": [light(), dark()],
    }
    out = Path(__file__).resolve().parent.parent / "assets/themes/intellij/intellij.json"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(family, indent=2) + "\n")
    print(f"wrote {out}")


if __name__ == "__main__":
    main()
