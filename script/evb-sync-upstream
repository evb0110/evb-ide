#!/usr/bin/env bash
# Rebases the EVB IDE commits onto the latest upstream Zed main.
#
# EVB IDE keeps its changes as a short series of commits on `main` on top of
# zed-industries/zed. Most of them live in files upstream never touches
# (assets/settings/evb.json, assets/keymaps/evb.json, crates/evb_run, script/evb-*),
# so rebases usually apply cleanly; the rest are small hooks into upstream files.
#
# Usage: script/evb-sync-upstream
# Stops on conflicts; resolve them, `git rebase --continue`, then rerun the checks
# listed in EVB.md.

set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
    echo "The working tree has uncommitted changes; commit or stash them first." >&2
    exit 1
fi

git remote get-url upstream >/dev/null 2>&1 ||
    git remote add upstream https://github.com/zed-industries/zed.git
git fetch upstream main

base="$(git merge-base HEAD upstream/main)"
echo "EVB commits on top of upstream:"
git log --oneline "$base..HEAD"
echo "Upstream commits to take: $(git rev-list --count "$base..upstream/main")"

git rebase upstream/main
echo "Rebased onto $(git rev-parse --short upstream/main)."
