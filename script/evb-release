#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"
publish=false
case "${1:-}" in
    --publish) publish=true ;;
    '') ;;
    *) echo 'Usage: script/evb-release [--publish]' >&2; exit 2 ;;
esac

[[ "$(uname -s)" == Darwin ]] || { echo 'Public packaging currently requires macOS.' >&2; exit 1; }
[[ -z "$(git status --porcelain)" ]] || { echo 'Commit changes before building a release.' >&2; exit 1; }
version="$(tr -d '\n' < EVB_VERSION)"
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo 'Invalid EVB_VERSION.' >&2; exit 1; }
commit="$(git rev-parse HEAD)"
tag="v$version"
architecture="$(uname -m)"
case "$architecture" in arm64) ;; x86_64) architecture=x64 ;; *) echo 'Unsupported Mac architecture.' >&2; exit 1 ;; esac
output="$repo_root/.devkit/releases/$tag"
app_path="$repo_root/target/evb-bundle/EVB IDE.app"
image_name="EVB-IDE-$version-macos-$architecture.dmg"
source_name="EVB-IDE-$version-source.tar.gz"

notarize() {
    if [[ -n "${EVB_NOTARY_PROFILE:-}" ]]; then
        xcrun notarytool submit "$1" --keychain-profile "$EVB_NOTARY_PROFILE" --wait
    else
        xcrun notarytool submit "$1" --key "$APPLE_API_KEY" --key-id "$APPLE_API_KEY_ID" --issuer "$APPLE_API_ISSUER" --wait
    fi
}

# Stapling downloads the ticket Apple just issued; right after notarization that lookup can drop
# its connection (NSURLErrorDomain -1005) before the ticket propagates.
# Stapling and validating both look the ticket up at Apple, whose connection
# sometimes drops on CI runners.
retry_stapler() {
    local attempt
    for attempt in 1 2 3 4 5; do
        xcrun stapler "$1" "$2" && return 0
        echo "stapler $1 $2 failed (attempt $attempt); retrying in $((attempt * 15)) s." >&2
        sleep $((attempt * 15))
    done
    return 1
}

if [[ "$publish" == true ]]; then
    [[ -f "$output/verified-commit" && "$(cat "$output/verified-commit")" == "$commit" ]] || { echo 'Prepare and verify this exact commit first.' >&2; exit 1; }
    (cd "$output" && shasum -a 256 -c SHA256SUMS)
    retry_stapler validate "$output/$image_name"
    git fetch --quiet origin main
    remote_commit="$(git rev-parse FETCH_HEAD)"
    git merge-base --is-ancestor "$commit" "$remote_commit" || { echo 'Push this commit to origin/main before publishing.' >&2; exit 1; }
    # The latest release is what installed copies update to, so it never goes back. This runs
    # here, just before publishing, for the workflow and for a local publication alike.
    latest="$(gh release view --repo evb0110/evb-ide --json tagName --jq '.tagName | ltrimstr("v")')"
    if [[ "$version" == "$latest" || "$(printf '%s\n%s\n' "$latest" "$version" | sort -V | tail -n 1)" != "$version" ]]; then
        echo "EVB_VERSION $version must be newer than the latest release $latest." >&2
        exit 1
    fi
    # Upstream Zed's tags share these names. An existing tag elsewhere would carry this release
    # (and its source downloads) on another commit, so it must point here already.
    tagged="$(git ls-remote origin "refs/tags/$tag" "refs/tags/$tag^{}" | awk '{ print $1 }' | tail -n 1)"
    [[ -z "$tagged" || "$tagged" == "$commit" ]] || { echo "Tag $tag already exists on GitHub at $tagged, not $commit." >&2; exit 1; }
    # Every release ships all three systems: an installed copy updates only to its own archive.
    other_systems=("$output/EVB-IDE-$version-linux-x64.tar.gz" "$output/EVB-IDE-$version-windows-x64.zip")
    for archive in "${other_systems[@]}"; do
        [[ -f "$archive" ]] || { echo "Missing $(basename "$archive"): add the Linux and Windows archives first." >&2; exit 1; }
        grep -q "  $(basename "$archive")\$" "$output/SHA256SUMS" || { echo "SHA256SUMS does not list $(basename "$archive")." >&2; exit 1; }
    done
    gh release create "$tag" --repo evb0110/evb-ide --target "$commit" --draft \
        --title "EVB IDE $version" --notes-file "$output/RELEASE-NOTES.md" \
        "$output/$image_name" "${other_systems[@]}" "$output/$source_name" "$output/SHA256SUMS"
    gh release edit "$tag" --repo evb0110/evb-ide --draft=false --latest
    gh release view "$tag" --repo evb0110/evb-ide --json url,tagName,targetCommitish,assets
    exit 0
fi

[[ -n "${EVB_SIGNING_IDENTITY:-}" && "$EVB_SIGNING_IDENTITY" != - ]] || { echo 'Set EVB_SIGNING_IDENTITY to a Developer ID Application identity.' >&2; exit 1; }
if [[ -z "${EVB_NOTARY_PROFILE:-}" ]]; then
    : "${APPLE_API_KEY:?Set notarization credentials or EVB_NOTARY_PROFILE}"
    : "${APPLE_API_KEY_ID:?Set APPLE_API_KEY_ID}"
    : "${APPLE_API_ISSUER:?Set APPLE_API_ISSUER}"
fi
[[ ! -e "$output/verified-commit" ]] || { echo "A prepared release already exists at $output; do not overwrite its artifacts." >&2; exit 1; }
notes_file="release-notes/$tag.md"
[[ -s "$notes_file" ]] || { echo "Write the release notes in $notes_file first." >&2; exit 1; }
mkdir -p "$output"

script/evb-install -n
[[ "$(git rev-parse HEAD)" == "$commit" && -z "$(git status --porcelain)" ]] || { echo 'Source changed during the build; rebuild from a clean, unchanged commit.' >&2; exit 1; }
codesign --verify --deep --strict "$app_path"
signature_details="$(codesign -dv --verbose=4 "$app_path" 2>&1)"
grep -q '^Authority=Developer ID Application:' <<< "$signature_details"
ditto -c -k --keepParent "$app_path" "$output/notarize.zip"
notarize "$output/notarize.zip"
retry_stapler staple "$app_path"
retry_stapler validate "$app_path"
spctl --assess --type execute --verbose=2 "$app_path"
"$app_path/Contents/MacOS/evb-ide" --system-specs > "$output/system-specs.txt"
grep -q "EVB IDE: v$version" "$output/system-specs.txt"
rm "$output/notarize.zip"

# dmgbuild writes the Finder layout (background, icon positions) into the image directly, without
# scripting Finder, so it also works on headless CI runners.
dmg_resources="$repo_root/crates/zed/resources/evb/dmg"
dmgbuild_environment="$output/dmgbuild"
python3 -m venv "$dmgbuild_environment"
"$dmgbuild_environment/bin/pip" install --quiet --require-hashes --only-binary :all: -r "$dmg_resources/requirements.txt"
"$dmgbuild_environment/bin/dmgbuild" -s "$dmg_resources/settings.py" \
    -D application="$app_path" -D background="$dmg_resources/background.png" \
    "EVB IDE $version" "$output/$image_name"
rm -rf "$dmgbuild_environment"
codesign --force --sign "$EVB_SIGNING_IDENTITY" --timestamp "$output/$image_name"
notarize "$output/$image_name"
retry_stapler staple "$output/$image_name"
retry_stapler validate "$output/$image_name"

source_root="$output/EVB-IDE-$version-source"
mkdir -p "$source_root"
git archive "$commit" | tar -x -C "$source_root"
(cd "$source_root" && cargo vendor --locked --versioned-dirs vendor) > "$output/vendor-config.toml"
cat "$output/vendor-config.toml" >> "$source_root/.cargo/config.toml"
printf '%s\n' "$commit" > "$source_root/SOURCE_COMMIT"
cp assets/licenses.md "$source_root/assets/licenses.md"
mkdir -p "$source_root/native"
curl --fail --location --proto '=https' --tlsv1.2 \
    'https://github.com/zed-industries/livekit-rust-sdks/archive/55ea4a4e0736d5301170594db0b901d5db060a0d.tar.gz' \
    --output "$source_root/native/livekit-webrtc-build-source.tar.gz"
curl --fail --location --proto '=https' --tlsv1.2 \
    'https://github.com/webrtc-sdk/webrtc/archive/0001d84a16a3502e45b86a065253df4c511026ae.tar.gz' \
    --output "$source_root/native/webrtc-source.tar.gz"
cat > "$source_root/REBUILD.md" <<EOF
# Rebuild EVB IDE $version

Source commit: $commit
Source tag: https://github.com/evb0110/evb-ide/tree/$tag

This archive contains the exact application sources, build scripts, license
notices, Cargo.lock, and vendored Rust dependency sources. The Cargo source
configuration points to the included vendor directory.

Install the prerequisites in EVB.md: Xcode with its Metal toolchain, CMake,
and rustup. From this directory, run script/evb-install -n. That produces a
local ad-hoc-signed app; your own signing identity is needed for public
Developer ID signing. Third-party build scripts may fetch platform toolchains
or native components as described in their sources. See NATIVE-SOURCES.md
for native dependency sources and WebRTC rebuild instructions.

The landing page builds separately using Node 24.21.0 and its pnpm lockfile.
No signing credentials or private keys are part of this source archive.
EOF
(cd "$output" && tar -czf "$source_name" "EVB-IDE-$version-source")
rm -rf "$source_root" "$output/vendor-config.toml"
(cd "$output" && shasum -a 256 "$image_name" "$source_name" > SHA256SUMS)

cat > "$output/RELEASE-NOTES.md" <<EOF
EVB IDE is an independent open-source fork of Zed with JetBrains shortcuts,
IntelliJ themes and file icons, run configurations, and Git tools for web development.

- macOS 12 or later, $architecture. Developer ID signed and Apple notarized.
- Open the DMG and drag EVB IDE into Applications. Installed copies update themselves from these releases.
- AI features, telemetry, and sign-in UI are disabled by default.
- The editor is GPL-3.0-or-later, with Apache-2.0 components where marked.
- Independent from Zed Industries and JetBrains. No hosted-service subscription is included.

## Corresponding source

[Exact source tag](https://github.com/evb0110/evb-ide/tree/$tag), commit $commit.
Download $source_name below for application sources, build instructions,
license notices, and vendored Rust dependency sources. SHA256SUMS covers every download.

Release Notes:

$(cat "$notes_file")
EOF
[[ "$(git rev-parse HEAD)" == "$commit" && -z "$(git status --porcelain)" ]] || { echo 'Source changed during preparation; do not publish these artifacts.' >&2; exit 1; }
printf '%s\n' "$commit" > "$output/verified-commit"
echo "Prepared $tag at $output. Verify app startup, then run script/evb-release --publish."
